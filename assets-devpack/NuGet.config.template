<?xml version="1.0" encoding="utf-8"?>
<!--
  Project-local NuGet config for Playwright offline development.

  Copy (or rename) this file to "NuGet.config" at the ROOT of your project /
  solution. Its <clear /> wipes every inherited package source (user-level,
  machine-level, and any solution-level one above this folder), so restore /
  add-package will ONLY look at the bundled PlaywrightOfflineFeed. This is the
  most robust way to guarantee strict offline behaviour, regardless of what
  other NuGet sources (corporate Azure DevOps feeds, proxies, etc.) the user's
  global config might declare.

  Used automatically by new-playwright-project.ps1 — you only need to copy this
  by hand if you are bootstrapping a project without the helper script.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="PlaywrightOfflineFeed" value="%USERPROFILE%\.nuget\packages" />
  </packageSources>
</configuration>
